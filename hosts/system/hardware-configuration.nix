{ config, lib, pkgs, modulesPath, ... }:

{
  # This file is normally fully auto-generated by `nixos-generate-config`
  # on the target machine during install (see Usage.md, Installation section).
  # It is pre-filled here with the values read from system-audit.txt so the
  # flake evaluates and builds today; re-run nixos-generate-config after the
  # real partitioning step and diff against this file before first boot.

  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # --- Boot-time kernel modules (NVMe root, USB, SD-card reader) ---
  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "usb_storage"
    "sd_mod"
    "sdhci_pci"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # --- Filesystems (from lsblk/fstab in system-audit.txt section 4) ---
  fileSystems."/" = {
    device = "/dev/disk/by-uuid/b8edfcad-4b21-457b-87ec-135cd8f9d8f6";
    fsType = "btrfs";
    options = [ "subvol=/" "ssd" "discard=async" "space_cache=v2" "compress=zstd" ];
  };

  fileSystems."/boot/efi" = {
    device = "/dev/disk/by-uuid/048D-515B";
    fsType = "vfat";
    options = [ "fmask=0022" "dmask=0022" ];
  };

  swapDevices = [ ];

  # --- Networking interfaces are DHCP-managed by NetworkManager ---
  networking.useDHCP = lib.mkDefault true;

  # --- Graphics stack: Intel Iris Xe (i915/xe) + NVIDIA RTX 4060 (PRIME offload) ---
  hardware.graphics = {
    enable = true;
    enable32Bit = true; # needed for Steam/Proton
  };

  services.xserver.videoDrivers = [ "nvidia" ];

  hardware.nvidia = {
    modesetting.enable = true;
    open = true; # equivalent of nvidia-open-dkms on Arch
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    powerManagement.enable = true;
    powerManagement.finegrained = true; # dynamic power-gating while idle, important on a laptop
    nvidiaSettings = true;

    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true; # provides `nvidia-offload <command>`
      };
      # Bus IDs derived from `lspci` in system-audit.txt:
      #   00:02.0 VGA ... Intel Iris Xe   -> PCI:0:2:0
      #   01:00.0 VGA ... NVIDIA RTX 4060 -> PCI:1:0:0
      intelBusId = "PCI:0:2:0";
      nvidiaBusId = "PCI:1:0:0";
    };
  };

  # --- CPU: Intel Raptor Lake-P (6P+8E), hybrid cores ---
  hardware.cpu.intel.updateMicrocode = true;

  # --- Platform quirks ---
  # The Gigabyte-specific WMI driver (gigabyte-laptop-wmi-dkms-git on AUR) has
  # no nixpkgs module as of writing. If you need its functionality (fan
  # control / keyboard backlight hooks), package it via an overlay and add
  # it to boot.extraModulePackages here.

  hardware.enableRedistributableFirmware = true;
}
