{ config, lib, pkgs, modulesPath, ... }:

{
  # This file is normally fully auto-generated by `nixos-generate-config`
  # on the target machine during install (see Usage.md, Installation section).
  #
  # `fileSystems` below is now written by LABEL (set by the `mkfs` commands in
  # Usage.md 1.2, Option A: EFI label "EFI", btrfs label "nixos"), not by UUID,
  # so the real install's UUIDs never need to be reconciled back into this
  # file at all. The one thing that still needs diffing against the real
  # `nixos-generate-config --show-hardware-config` output after partitioning
  # is `boot.initrd.availableKernelModules` — that list is hardware-detected
  # and can't be guessed from system-audit.txt the way the filesystem layout
  # can (see Usage.md 1.3).

  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # --- Boot-time kernel modules (NVMe root, USB, SD-card reader) ---
  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "usb_storage"
    "sd_mod"
    "sdhci_pci"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # --- Filesystems: btrfs subvolumes on one labeled partition + a labeled ESP ---
  # (Usage.md 1.2, Option A: `mkfs.btrfs -L nixos`, `mkfs.fat -F32 -n EFI`,
  # subvolumes @ / @home / @nix / @snapshots.) Mounting by label instead of
  # UUID means this block is correct the moment the disk is formatted with
  # those exact labels — no post-install UUID surgery needed.
  fileSystems."/" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@" "compress=zstd" "noatime" ];
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@home" "compress=zstd" "noatime" ];
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@nix" "compress=zstd" "noatime" ];
  };

  fileSystems."/.snapshots" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@snapshots" "compress=zstd" "noatime" ];
  };

  fileSystems."/boot/efi" = {
    device = "/dev/disk/by-label/EFI";
    fsType = "vfat";
    options = [ "fmask=0077" "dmask=0077" ];
  };

  # No swap partition — see zramSwap.enable in configuration.nix.
  swapDevices = [ ];

  # --- Networking interfaces are DHCP-managed by NetworkManager ---
  networking.useDHCP = lib.mkDefault true;

  # --- Platform quirks ---
  # The Gigabyte-specific WMI driver (gigabyte-laptop-wmi-dkms-git on AUR) has
  # no nixpkgs module as of writing. If you need its functionality (fan
  # control / keyboard backlight hooks), package it via an overlay and add
  # it to boot.extraModulePackages here.

  hardware.enableRedistributableFirmware = true;
}
