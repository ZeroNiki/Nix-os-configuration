@@ -1719,6 +1721,51 @@ incnmaster(const Arg *arg)
 	arrange(selmon);
 }
 
+void
+kblayout(KeyboardGroup *group)
+{
+	/* Write kblayout_names[active layout] to $XDG_RUNTIME_DIR/kblayout_file
+	 * and send SIGUSR1 to the bar's status script, whose pid is in
+	 * $XDG_RUNTIME_DIR/kblayout_pidfile, if that pid is still kblayout_comm */
+	xkb_layout_index_t idx = group->wlr_group->keyboard.modifiers.group;
+	const char *dir = getenv("XDG_RUNTIME_DIR"), *name;
+	char path[PATH_MAX], tmp[PATH_MAX + sizeof(".tmp")], comm[64] = "";
+	FILE *f;
+	int pid = 0;
+
+	if (idx == kblayout_idx || !dir)
+		return;
+	kblayout_idx = idx;
+
+	name = idx < LENGTH(kblayout_names) ? kblayout_names[idx]
+		: xkb_keymap_layout_get_name(group->wlr_group->keyboard.keymap, idx);
+	snprintf(path, sizeof(path), "%s/%s", dir, kblayout_file);
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	if (!(f = fopen(tmp, "w")))
+		return;
+	fprintf(f, "%s\n", name ? name : "?");
+	/* rename: a reader never sees a half-written file */
+	if (fclose(f) || rename(tmp, path))
+		return;
+
+	snprintf(path, sizeof(path), "%s/%s", dir, kblayout_pidfile);
+	if ((f = fopen(path, "r"))) {
+		if (fscanf(f, "%d", &pid) != 1)
+			pid = 0;
+		fclose(f);
+	}
+	if (pid <= 0)
+		return;
+	snprintf(path, sizeof(path), "/proc/%d/comm", pid);
+	if ((f = fopen(path, "r"))) {
+		if (fgets(comm, sizeof(comm), f))
+			comm[strcspn(comm, "\n")] = '\0';
+		fclose(f);
+	}
+	if (!strcmp(comm, kblayout_comm))
+		kill(pid, SIGUSR1);
+}
+
 void
 inputdevice(struct wl_listener *listener, void *data)
 {
@@ -1837,6 +1884,10 @@ keypressmod(struct wl_listener *listener, void *data)
 	/* Send modifiers to the client. */
 	wlr_seat_keyboard_notify_modifiers(seat,
 			&group->wlr_group->keyboard.modifiers);
+
+	/* a layout switch (grp:... in xkb_rules) comes as a modifiers event */
+	if (group == kb_group)
+		kblayout(group);
 }
 
